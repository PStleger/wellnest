# Postgres connection string. On Vercel, add Neon from the Marketplace and this is set for you.
# Locally: `docker compose up -d` gives you postgres://postgres:postgres@localhost:5432/wellnest
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wellnest

# Optional: a non-pooled URL for migrations (Supabase: the session pooler on port 5432).
# DATABASE_URL_UNPOOLED=

# Optional: the database's CA certificate (PEM) for verified TLS. Supabase needs this;
# download it from Database Settings → SSL Configuration. Leave sslmode out of the URLs.
# DATABASE_CA_CERT=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional locally; on Vercel the production URL is detected automatically.
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables "Continue with GitHub". Callback URL: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Protects the daily cron that removes old demo accounts. Vercel sends it automatically.
CRON_SECRET=

# Optional: how many guest demos one IP address can start per hour (default 20).
DEMO_LIMIT_PER_HOUR=
